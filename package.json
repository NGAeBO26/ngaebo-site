{
  "name": "ngaebo-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview --port $PORT --strictPort --host 0.0.0.0",
    "start": "node server.js",
    "dev:backend": "cd ngaebo-backend && npm run dev",
    "dev:all": "concurrently --kill-others-on-fail --names \"FRONTEND,MAIN-SRV,PG-API\" --prefix-colors \"cyan,blue,magenta\" \"npm run dev\" \"npm run start\" \"npm run dev:backend\""
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "jspdf": "^4.2.1",
    "maplibre-gl": "^4.7.1",
    "modern-screenshot": "^4.7.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.21.0",
    "proj4": "^2.20.4",
    "react": "^19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "serve": "^14.2.6",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/node": "^22.13.4",
    "@types/proj4": "^2.5.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^8.2.2",
    "eslint": "^9.20.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "typescript": "^5.7.3",
    "vite": "^8.0.16"
  }
}